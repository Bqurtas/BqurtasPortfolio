# Security + caching headers for Cloudflare Pages
# NOTE: the HTML pages themselves are served fresh (no long cache) so site
# updates always show immediately. Only static files get a short cache.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Permitted-Cross-Domain-Policies: none
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # Cloudflare Pages serves assets with a wildcard "Access-Control-Allow-Origin: *"
  # by default. The site is fully self-contained (all fetches are same-origin, which
  # don't need CORS), so pin the header to our own origin — no wildcard, nothing for
  # a third-party site to read cross-origin. This overrides the Pages default.
  Access-Control-Allow-Origin: https://bqurtas.com
  # NOTE: the Content-Security-Policy is set per-request by functions/[[route]].js
  # so it can carry a fresh nonce (nonce-based script-src, no 'unsafe-inline' for
  # scripts → XSS-effective). It is intentionally NOT set here to avoid a second,
  # conflicting CSP header on the HTML responses.
  # NOTE: no Cache-Control here on purpose. Cloudflare _headers CONCATENATES every
  # matching rule's same-named header, so a Cache-Control on /* would be merged
  # into /css, /js and /assets (e.g. "no-store, max-age=86400") and the most
  # restrictive directive would win — killing their cache. So the HTML shell's
  # cache is set ONLY by functions/[[route]].js (Cache-Control: no-store +
  # CDN-Cache-Control: no-store), and static files get their own rules below.

# The bare root "/" maps to index.html and Cloudflare re-applies its platform
# wildcard CORS to it specifically (every other path — /index.html, /bio,
# /design, /css, /js — already honours the /* pin above). An exact "/" rule
# pins the homepage too.
/
  Access-Control-Allow-Origin: https://bqurtas.com
  Cache-Control: no-store
  CDN-Cache-Control: no-store

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-store
  CDN-Cache-Control: no-store

/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: no-store
  CDN-Cache-Control: no-store

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-store
  CDN-Cache-Control: no-store

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-store
  CDN-Cache-Control: no-store

# Images & fonts are fingerprinted by file path or updated through new deploys.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CSS/JS are ?v-versioned, so a new edit is a new URL.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/.well-known/mta-sts.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
